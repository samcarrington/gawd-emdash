---
import { getWidgetAreaWithCacheHint } from "emdash";
import RoutedWidget from "./RoutedWidget.astro";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const { data: area, cacheHint } = await getWidgetAreaWithCacheHint(name);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

{area && area.widgets.length > 0 && (
  <div class:list={["widget-area", className]} data-widget-area={name}>
    {area.widgets.map((widget) => (
      <RoutedWidget widget={widget} />
    ))}
  </div>
)}
