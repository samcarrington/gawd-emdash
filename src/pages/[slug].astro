---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getEmDashCollection,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import DateArchive from "../components/DateArchive.astro";
import { getArchiveRange } from "../utils/post-urls";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const range = /^\d{4}$/.test(slug) ? getArchiveRange(slug) : null;
if (/^\d{4}$/.test(slug) && !range) return Astro.rewrite("/404");
const archive = range
	? await getEmDashCollection("posts", {
			where: { published_at: range },
			orderBy: { published_at: "desc" },
		})
	: null;
const pageResult = !range ? await getEmDashEntry("pages", slug) : null;
const error = archive?.error ?? pageResult?.error;
if (error) {
	console.error("Failed to load page or year archive:", error);
	return new Response("Unable to load content", { status: 500 });
}
const page = pageResult?.entry;

if (archive ? archive.entries.length === 0 : !page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) {
	if (archive) Astro.cache.set(archive.cacheHint);
	if (pageResult) Astro.cache.set(pageResult.cacheHint);
}
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = page ? getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
}) : null;
---

<Base
	title={seo?.title ?? `Posts from ${slug}`}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? `All posts published in ${slug}`}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug } : undefined}
>
	{archive && <DateArchive posts={archive.entries} title={`Posts from ${slug}`} year={slug} />}
	{page && (
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content" {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	</article>
	)}
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: var(--spacing-6);
		border-left: 3px solid var(--color-border);
		color: var(--color-muted);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
